# ── зависимости и сборка ──────────────────────────────────────────────────
/vendor/
/backend/bin/
/frontend/node_modules/
/frontend/dist/
# Инкрементальный кэш tsc (`tsc -b`): артефакт сборки, а не исходник.
/frontend/tsconfig.tsbuildinfo
/frontend/*.tsbuildinfo
/backend/.tmp/
/coverage/

# ── секреты и локальные настройки ────────────────────────────────────────
.env*
!.env.example

# ── артефакты тестов и аудита ────────────────────────────────────────────
/_audit_out/
/_audit_shots/
/_galactic_shots/
/_shots_*/
/_route_shots/
/_admin_shots/
/_transfer_shots/
/_mobile_diag/
/frontend/_shots_*/
/screenshots/
*.log

# ── состояние механизма обновления (лежит на хосте, не в репозитории) ────
/update-state/
/backend/update-state/

# ── системное ────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
backend/tmp/
backend/migrations/*.tmp
backend/cmd/server/projctx.go.bak

# Скриншоты в документации — часть репозитория, остальные PNG не коммитим
*.png
!docs/**/*.png

# ── резервные копии (deploy/backup.sh, лежат на хосте) ───────────────────
/backups/
# Служебные артефакты настройки офсайта: ключи MinIO, probe-объект, локальный
# rclone.conf. В репозитории им делать нечего.
/.s3tools/
/.s3creds*
/.s3cand.txt
# Настройки копирования конкретного стенда: офсайт, хранение (образец —
# deploy/backup.env.example). Файл стенда, в репозиторий не попадает.
/backup.env

# ── артефакты браузерных прогонов ────────────────────────────────────────
# Playwright складывает сюда снимки и разметку упавших сценариев: они нужны при
# разборе падения в CI (job e2e выкладывает их артефактом), но не в репозитории.
/frontend/test-results/
/frontend/playwright-report/
# Локальный стенд для e2e по README: собранный бинарник backend и каталог файлов
# проекта. В репозиторий не попадает — это 20+ МБ артефактов сборки и прогона.
/.e2e/
# Текст коммита пишется в файл на время коммита (иначе кириллица в PowerShell
# превращается в мусор) — в репозиторий он попадать не должен.
/commitmsg.txt
