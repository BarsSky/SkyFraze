# ── обязательное ─────────────────────────────────────────────────────────
# 32+ случайных байта: openssl rand -hex 32
JWT_SECRET=replace-with-32-bytes-random-string-in-prod

# ── администрирование развёртывания ──────────────────────────────────────
# Кто администратор (через запятую). Пусто → им станет первый зарегистрированный.
ADMIN_EMAILS=you@example.com
# request — только по заявке (по умолчанию) | open — свободная регистрация
REGISTRATION_MODE=request

# ── обновление из GitHub (админка → «Обновление») ────────────────────────
# Репозиторий-источник релизов: owner/name. Пусто → раздел скажет, что источник не настроен.
UPDATE_REPO=BarsSky/SkyFraze
# Токен нужен только для приватного репозитория или чтобы поднять лимит GitHub API
# UPDATE_TOKEN=
# stable — игнорировать предрелизы (по умолчанию) | any
UPDATE_CHANNEL=stable

# ── сервер (docker-compose.prod.yml) ─────────────────────────────────────
# Порт, на котором открыт UI
SKYFRAZE_PORT=80
# Внешний адрес стенда — нужен для CORS и проверки Origin у WebSocket
CORS_ORIGINS=http://localhost

# ── вложения и ИИ-помощник ───────────────────────────────────────────────
# Предел суммы вложений проекта после пережатия, байт (по умолчанию 10 МиБ)
# ASSET_QUOTA_BYTES=10485760

# ИИ-помощник выключен по умолчанию: включение означает, что текст проекта
# уходит провайдеру модели. Локальная модель (Ollama) не отправляет ничего.
# Подробности и фазы — docs/ai-assistant.md
# AI_ENABLED=true
# AI_OLLAMA_URL=http://ollama:11434
# AI_OPENAI_COMPAT_URL=
# Ключ шифрования пользовательских ключей: 32 байта hex (openssl rand -hex 32).
# Пусто → «свой ключ» выключен целиком.
# AI_SECRET_KEY=
# AI_DEFAULT_MODEL=ollama:qwen2.5:7b
# AI_MAX_TOOL_CALLS=10
# AI_TIMEOUT_SECONDS=120

# Ключи стенда к размещённым провайдерам — необязательны: без них работают
# локальная модель и ключи самих пользователей.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# CUSTOM_AI_API_KEY=
