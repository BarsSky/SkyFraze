# ── обязательное ─────────────────────────────────────────────────────────
# 32+ случайных байта: openssl rand -hex 32
JWT_SECRET=replace-with-32-bytes-random-string-in-prod

# ── администрирование развёртывания ──────────────────────────────────────
# Кто администратор (через запятую). Пусто → им станет первый зарегистрированный.
ADMIN_EMAILS=you@example.com
# request — только по заявке (по умолчанию) | open — свободная регистрация
REGISTRATION_MODE=request

# ── обновление из GitHub (админка → «Обновление») ────────────────────────
# Репозиторий-источник релизов: owner/name. Пусто → раздел скажет, что источник не настроен.
UPDATE_REPO=BarsSky/SkyFraze
# Токен нужен только для приватного репозитория или чтобы поднять лимит GitHub API
# UPDATE_TOKEN=
# stable — игнорировать предрелизы (по умолчанию) | any
UPDATE_CHANNEL=stable

# ── сервер (docker-compose.prod.yml) ─────────────────────────────────────
# Порт, на котором открыт UI
SKYFRAZE_PORT=80
# Внешний адрес стенда — нужен для CORS и проверки Origin у WebSocket
CORS_ORIGINS=http://localhost
