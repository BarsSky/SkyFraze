# SkyFraze — пример настроек стенда (0.154.0).
#
# Как пользоваться: скопировать в `.env` рядом с docker-compose.prod.yml и заполнить.
# Все переменные необязательны, кроме DATABASE_URL, JWT_SECRET и (для docker) значений
# compose. Пустое значение = «умолчание из кода»; перечень ниже сверен с
# backend/internal/platform/config.go и docker-compose.prod.yml.
#
# ВАЖНО: стенд обновляется скриптом deploy/skyfraze-update.sh, и он перезаписывает
# docker-compose.prod.yml из репозитория, а `.env` — НЕ трогает. Поэтому свои значения
# держите именно здесь, а не в compose.
#
# После правки `.env` нужен `docker compose -f docker-compose.prod.yml up -d
# --force-recreate backend` — обычный `up -d` может ответить «Running» и не применить
# новые значения (проверено на S3_* и NOTIFY_*).

# ── Развёртывание (compose) ───────────────────────────────────────────────────────────
# Порт, который публикует фронтенд-nginx на хосте.
SKYFRAZE_PORT=8080
# Версию и коммит выставляет deploy/skyfraze-update.sh; вручную не задавайте.
# SKYFRAZE_VERSION=
# SKYFRAZE_COMMIT=
# Postgres в compose (наружу не публикуется).
# POSTGRES_USER=skyfraze
# POSTGRES_PASSWORD=skyfraze_dev
# POSTGRES_DB=skyfraze

# ── Приложение ───────────────────────────────────────────────────────────────────────
# Адрес прослушивания backend внутри контейнера.
LISTEN=:8080
# Полная строка подключения к Postgres (docker-сеть, не localhost).
DATABASE_URL=postgres://skyfraze:skyfraze_dev@postgres:5432/skyfraze?sslmode=disable
# Секрет подписи JWT. Обязателен; смена разлогинивает всех.
JWT_SECRET=change-me
# Адреса, которым разрешены CORS-запросы (через запятую).
CORS_ORIGINS=https://fraze.skynas.ru
# Внешний адрес приложения: нужен в письмах-приглашениях и ссылках восстановления.
APP_BASE_URL=https://fraze.skynas.ru
# Режим регистрации: open | request (заявкой) | closed.
REGISTRATION_MODE=request
# Emails администраторов через запятую: при развёртывании им выдаются права.
ADMIN_EMAILS=
# Предел вложений на проект (байты); 0 — без предела.
ASSET_QUOTA_BYTES=10485760
# Ограничения попыток входа; 0 — выключить (не рекомендуется).
AUTH_RATE_PER_MINUTE=30
AUTH_LOGIN_PER_EMAIL_PER_MINUTE=5

# ── Хранилище вложений ───────────────────────────────────────────────────────────────
# local — файлы в STORAGE_DIR; s3 — объектное хранилище (тогда S3_* ниже).
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# S3_ENDPOINT=
# S3_BUCKET=skyfraze-assets
# S3_PREFIX=
# S3_REGION=us-east-1
# S3_KEY=
# S3_SECRET=
# S3_USE_SSL=false

# ── Письма (приглашения, упоминания, уведомления) ────────────────────────────────────
# Пустой NOTIFY_SMTP_HOST выключает отправку: письма остаются в очереди, сервер работает.
# NOTIFY_SMTP_HOST=
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_USER=
# NOTIFY_SMTP_PASS=
# NOTIFY_FROM=
# NOTIFY_SMTP_TLS=false
# NOTIFY_INTERVAL_SECONDS=60

# ── Обновления (GitHub Releases) ─────────────────────────────────────────────────────
# UPDATE_REPO=BarsSky/SkyFraze
# UPDATE_TOKEN=          # нужен только для приватного репозитория
UPDATE_CHANNEL=stable

# ── Резервные копии версий ───────────────────────────────────────────────────────────
# VERSIONS_INTERVAL_MINUTES=5
# VERSIONS_KEEP=100
# VERSIONS_MAX_MB=32

# ── Помощник (ИИ) ────────────────────────────────────────────────────────────────────
# Главный выключатель: по умолчанию выключен — текст проекта уходит третьей стороне.
AI_ENABLED=false
# Локальные серверы моделей (общие для стенда). Каждый пользователь может добавить свои
# в окне помощника — это админской настройки не требует.
# AI_OLLAMA_URL=http://127.0.0.1:11434
# AI_OLLAMA_NUM_CTX=0
# AI_OPENAI_COMPAT_URL=http://127.0.0.1:8080/v1
# AI_OPENAI_COMPAT_LOCAL=true
# Модель по умолчанию — ссылка `провайдер:модель` (custom:…, ollama:…, groq:…).
# AI_DEFAULT_MODEL=custom:qwen2.5:7b
# Предел ответа модели в токенах. 4096 — умолчание кода; больше — дороже и рискованнее.
# AI_MAX_OUTPUT_TOKENS=4096
# Сколько инструментов модель может вызвать за одно сообщение.
# AI_MAX_TOOL_CALLS=10
# Таймауты: общий, ожидание первых байт (загрузка модели), молчание в потоке.
# AI_TIMEOUT_SECONDS=120
# AI_LOAD_WAIT_SECONDS=240
# AI_STREAM_IDLE_SECONDS=120
# Предел расхода на человека за сутки (0 — без предела).
# AI_TOKENS_PER_DAY=0
# Ключи провайдеров (ключ стенда; пользователь может добавить свой).
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# CUSTOM_AI_API_KEY=
# Ключ шифрования пользовательских ключей (AES-256-GCM): без него свои ключи выключены.
# AI_SECRET_KEY=
# Диагностика: содержимое запросов и ответов модели (текст проекта!) — по умолчанию нет.
AI_DEBUG=false
# Метаданные модели (провайдер, модель, лимит, оценка токенов, время) без содержимого.
AI_LOG_META=true
# Генерация иллюстраций: A1111-совместимый сервер.
# AI_IMAGE_URL=
# AI_IMAGE_MODEL=
# AI_IMAGE_TIMEOUT_SECONDS=180
# AI_IMAGE_STEPS=0
# AI_IMAGE_AUTOLOAD=true
# AI_IMAGE_NEGATIVE=
