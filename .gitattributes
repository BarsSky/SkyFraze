# Единые переводы строк: shell-скрипты в репозитории должны оставаться LF,
# иначе они не запускаются на Linux («bad interpreter: ^M»).
* text=auto

*.sh   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.go   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf

*.png  binary
*.jpg  binary
*.zip  binary
# Бинарные апдейты Yjs для серверных тестов (backend/internal/collab/yjs/testdata):
# без явного правила git считает их текстом и может испортить переводом строк.
*.bin  binary
